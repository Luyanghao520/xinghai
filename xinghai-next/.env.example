# 环境变量样例：复制为 .env 后按需修改（.env 不会被提交）

# 后台口令（配置后 /admin 才可用；不配置 = 后台整体关闭）
# ADMIN_TOKEN=请改成足够长的随机口令

# 站点对外 URL（上线后必须设置，用于 sitemap/robots/OG 链接；不设置回退 localhost）
# NEXT_PUBLIC_SITE_URL=https://xinghai.example.com

# SQLite 数据库文件路径（默认 data/xinghai.db）
# XINGHAI_DB_PATH=./data/xinghai.db

# 旧栈数据库所在目录（迁移脚本用，默认仓库根目录）
# LEGACY_DIR=..
